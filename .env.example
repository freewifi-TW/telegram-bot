# 必填：從 @BotFather 取得的 bot token
BOT_TOKEN=123456789:ABCDEF...

# 選填：擁有者的 Telegram user id（逗號分隔），不論群組權限一律視為管理員
OWNER_IDS=

# 選填：資料檔路徑（預設 ./data/bot.json）
DATA_FILE=./data/bot.json

# 以圖搜圖：SauceNAO API key（https://saucenao.com/user.php?page=search-api）
# 沒填也能用，但匿名額度很低
SAUCENAO_API_KEY=
# SauceNAO 最低相似度（百分比），低於此值的結果不顯示
SAUCENAO_MIN_SIMILARITY=60

# e621 要求自訂 User-Agent，格式：專案名/版本 (by 你的e621帳號)
E621_USER_AGENT=MachineChubbyBot/1.0 (by your_e621_username)
# 選填：e621 帳號與 API key（提高額度用）
E621_LOGIN=
E621_API_KEY=
