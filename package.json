{
  "name": "machinechubbybot",
  "version": "1.0.0",
  "private": true,
  "description": "Telegram 話題型群組管理 bot：歡迎詞、身分組、tag、fixupx 連結、以圖搜圖",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dotenv": "^18.0.6",
    "grammy": "^1.46.0"
  }
}
